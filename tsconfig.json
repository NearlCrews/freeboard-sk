{
  // Root TS config: strict-but-not-strict-templates. The component .ts
  // surface (src/app/lib, src/app/modules, src/app/stores, src/app/shell,
  // and the bootstrap+facade+config) is strict-clean per the Phase 5
  // ratchet. Templates remain on Angular's basic fullTemplateTypeCheck
  // until Phase 5e (template-side strict pass) lands. To gate new .ts
  // code as strict, the surfaces that survive a strict template TCB
  // are listed in tsconfig.strict.json which scripts/typecheck-strict.mjs
  // enforces in pre-push.
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "baseUrl": "./",
    "sourceMap": true,
    "declaration": false,
    "typeRoots": ["node_modules/@types"],
    "paths": {}
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
