{
  // Parallel strict tsconfig for the Phase 0 ratchet (src/app/lib/ only).
  // Later phases widen the include and ultimately flip strict:true in
  // tsconfig.json. See MODERNIZATION_ROADMAP.md sections 3 (Phase 0) and 5.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./out-tsc/strict",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [],
  "include": ["src/app/lib/**/*.ts"],
  "exclude": ["src/app/lib/**/*.spec.ts", "src/app/lib/**/*.worker.ts"]
}
