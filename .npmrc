engine-strict=true
auto-install-peers=true
# Enable arbitrary `pre<name>` and `post<name>` script hooks. Required for the
# `prebuild` and `prebuild:web` hooks that refresh src/types/signalk-generated.ts
# from @signalk/signalk-schema before the Angular compiler runs. The generated
# file is committed, so CI does not depend on this; it keeps local builds in sync.
enable-pre-post-scripts=true
