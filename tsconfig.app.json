{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"]
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts", "src/types/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "helper/**/*",
    "helper/openApi.json",
    "src/**/*.worker.ts"
  ]
}
