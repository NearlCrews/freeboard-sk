{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
